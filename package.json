{
	"repository": {
		"type": "git",
		"url": "https://github.com/ericbiewener/obsidian-lock-screen-plugin"
	},
	"scripts": {
		"start": "node esbuild.config.mjs",
		"build": "rm -rf dist && tsc -noEmit -skipLibCheck && NODE_ENV=production node esbuild.config.mjs",
		"format": "prettier --write --no-error-on-unmatched-pattern **/*.{ts,js,json,md}, *.{ts,js,json,md}",
		"prepare": "husky install",
		"release": "ts-node --project=./tsconfig.scripts.json ./scripts/create-release.ts"
	},
	"keywords": [],
	"author": "Eric Biewener",
	"license": "MIT",
	"version": "1.3.0",
	"devDependencies": {
		"@types/inquirer": "9.0.9",
		"@types/node": "25.6.0",
		"@typescript-eslint/eslint-plugin": "8.58.1",
		"@typescript-eslint/parser": "8.58.1",
		"builtin-modules": "5.0.0",
		"compare-versions": "6.1.1",
		"esbuild": "0.28.0",
		"fs-extra": "11.3.4",
		"husky": ">=9",
		"inquirer": "13.4.1",
		"lint-staged": ">=16",
		"obsidian": "1.12.3",
		"open": "11.0.0",
		"prettier": "3.8.2",
		"prettier-plugin-organize-imports": "4.3.0",
		"ts-node": "10.9.2",
		"tslib": "2.8.1",
		"typescript": "6.0.2",
		"zx": "8.8.5"
	},
	"lint-staged": {
		"*.{ts,js,json,md}": "prettier --write"
	}
}
