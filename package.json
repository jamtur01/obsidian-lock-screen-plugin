{
	"name": "obsidian-lock-screen-plugin",
	"version": "2.0.0",
	"private": true,
	"license": "MIT",
	"author": "Eric Biewener and James Turnbull",
	"repository": {
		"type": "git",
		"url": "https://github.com/jamtur01/obsidian-lock-screen-plugin"
	},
	"type": "module",
	"imports": {
		"#src/*": "./src/*.ts",
		"#test/*": "./test/*.ts"
	},
	"scripts": {
		"build": "npm run typecheck && node esbuild.config.mjs --production",
		"check": "npm run format:check && npm run lint && npm test && npm run build",
		"dev": "node esbuild.config.mjs",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"lint": "oxlint --deny-warnings .",
		"prepare": "husky",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
	},
	"devDependencies": {
		"@types/jsdom": "30.0.0",
		"@types/node": "24.13.3",
		"esbuild": "0.28.2",
		"husky": "9.1.7",
		"jsdom": "30.0.1",
		"lint-staged": "17.3.0",
		"obsidian": "1.13.1",
		"oxfmt": "0.63.0",
		"oxlint": "1.78.0",
		"typescript": "7.0.2",
		"vitest": "4.1.10"
	},
	"lint-staged": {
		"*.{js,mjs,ts}": [
			"oxfmt --write",
			"oxlint --deny-warnings"
		],
		"*.{css,json,md}": "oxfmt --write"
	},
	"engines": {
		"node": ">=24.13.0 <25"
	}
}
